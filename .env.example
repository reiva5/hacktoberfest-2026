# Any OpenAI-compatible endpoint serving Gemma works: Ollama, vLLM, llama.cpp server, LM Studio, or a hosted provider.
# Ollama:  ollama pull gemma3:12b && ollama pull gemma3:4b
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=gemma3:12b
# Small model for cheap yes/no page classification during discovery
LLM_SMALL_MODEL=gemma3:4b
# 1 = send deck slides as images (Gemma 3 4B+ accepts images); 0 = PDF text only
LLM_VISION=1

GATEWAY_DB=data/gateway.db
GATEWAY_CACHE=data/cache
# Seconds between requests to the same host
CRAWL_DELAY=2
USER_AGENT=StartupASEANGatewayBot/0.1 (hackathon prototype; contact: team@example.org)
