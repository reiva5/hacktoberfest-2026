# Gemma 4 only. Gemini API hosts gemma-4-26b-a4b-it and gemma-4-31b-it.
LLM_PROVIDER=gemini
LLM_MODEL=gemma-4-31b-it
LLM_SMALL_MODEL=gemma-4-31b-it
# Set an absolute path to a UTF-8 file containing only the key. Do not commit the file.
# LLM_API_KEY_FILE=C:\private\gemma-api-key.txt
# Alternatively set LLM_API_KEY in your process environment. Never print or commit it.

# Local alternative: LLM_PROVIDER=openai, LLM_MODEL=gemma4:e4b,
# LLM_SMALL_MODEL=gemma4:e4b; run ollama pull gemma4:e4b.
# LLM_BASE_URL and LLM_API_KEY below apply to the local alternative, not Gemini API.
# Ollama defaults to a 4096-token context, which silently cuts long pages. Set this user env var and restart Ollama:
#   OLLAMA_CONTEXT_LENGTH=16384
LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# 1 = send deck slides as images; 0 = PDF text only
LLM_VISION=1

GATEWAY_DB=data/gateway.db
GATEWAY_CACHE=data/cache
# Seconds between requests to the same host
CRAWL_DELAY=2
USER_AGENT=StartupASEANGatewayBot/0.1 (hackathon prototype; contact: team@example.org)
