{
  "components": {
    "schemas": {
      "Body_deck_deck_post": {
        "properties": {
          "file": {
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "type": "string"
          }
        },
        "required": [
          "file"
        ],
        "title": "Body_deck_deck_post",
        "type": "object"
      },
      "Funding": {
        "properties": {
          "amount": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Largest amount on offer, as a number. null if not stated.",
            "title": "Amount"
          },
          "currency": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "ISO 4217 code, e.g. MYR, SGD, USD.",
            "title": "Currency"
          },
          "equity_free": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "description": "true if no equity is taken. null if unclear.",
            "title": "Equity Free"
          },
          "equity_pct": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Equity taken in percent, if stated.",
            "title": "Equity Pct"
          }
        },
        "title": "Funding",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "IngestRequest": {
        "properties": {
          "url": {
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "title": "IngestRequest",
        "type": "object"
      },
      "Match": {
        "properties": {
          "days_left": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Days Left"
          },
          "program": {
            "$ref": "#/components/schemas/Program"
          },
          "reasons": {
            "items": {
              "type": "string"
            },
            "title": "Reasons",
            "type": "array"
          },
          "score": {
            "title": "Score",
            "type": "integer"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "title": "Warnings",
            "type": "array"
          }
        },
        "required": [
          "program",
          "score",
          "reasons",
          "warnings",
          "days_left"
        ],
        "title": "Match",
        "type": "object"
      },
      "Profile": {
        "properties": {
          "company": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Company"
          },
          "country": {
            "description": "ISO 3166-1 alpha-2 code of the country of incorporation.",
            "title": "Country",
            "type": "string"
          },
          "evidence": {
            "additionalProperties": {
              "type": "integer"
            },
            "description": "Field name -> slide number it was read from.",
            "title": "Evidence",
            "type": "object"
          },
          "founder_nationalities": {
            "description": "ISO codes.",
            "items": {
              "type": "string"
            },
            "title": "Founder Nationalities",
            "type": "array"
          },
          "looking_for": {
            "items": {
              "enum": [
                "accelerator",
                "grant",
                "competition",
                "gov_scheme",
                "credits",
                "investment",
                "other"
              ],
              "type": "string"
            },
            "title": "Looking For",
            "type": "array"
          },
          "sectors": {
            "description": "Lowercase English sector names.",
            "items": {
              "type": "string"
            },
            "title": "Sectors",
            "type": "array"
          },
          "stage": {
            "enum": [
              "idea",
              "pre-seed",
              "seed",
              "series-a+"
            ],
            "title": "Stage",
            "type": "string"
          },
          "wants_equity_free": {
            "default": false,
            "title": "Wants Equity Free",
            "type": "boolean"
          }
        },
        "required": [
          "country",
          "stage"
        ],
        "title": "Profile",
        "type": "object"
      },
      "Program": {
        "properties": {
          "canonical_url": {
            "default": "",
            "title": "Canonical Url",
            "type": "string"
          },
          "confidence": {
            "default": 1.0,
            "title": "Confidence",
            "type": "number"
          },
          "countries": {
            "description": "Where applicants must be based. Country names or ISO codes; 'ASEAN' for region-wide; 'GLOBAL' if open worldwide.",
            "items": {
              "type": "string"
            },
            "title": "Countries",
            "type": "array"
          },
          "deadline": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Application deadline as YYYY-MM-DD. null if rolling or not stated.",
            "title": "Deadline"
          },
          "eligibility": {
            "description": "Each eligibility rule as a short English sentence.",
            "items": {
              "type": "string"
            },
            "title": "Eligibility",
            "type": "array"
          },
          "funding": {
            "$ref": "#/components/schemas/Funding"
          },
          "id": {
            "default": "",
            "title": "Id",
            "type": "string"
          },
          "issues": {
            "items": {
              "type": "string"
            },
            "title": "Issues",
            "type": "array"
          },
          "language": {
            "default": "en",
            "title": "Language",
            "type": "string"
          },
          "last_verified": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Verified"
          },
          "organiser": {
            "title": "Organiser",
            "type": "string"
          },
          "organiser_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Homepage of the organising body, if linked.",
            "title": "Organiser Url"
          },
          "program_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Link to this program's own page or application page, if present in the text.",
            "title": "Program Url"
          },
          "rolling": {
            "default": false,
            "description": "true if applications are accepted on a rolling basis.",
            "title": "Rolling",
            "type": "boolean"
          },
          "sectors": {
            "description": "Target sectors in lowercase English. Empty if sector-agnostic.",
            "items": {
              "type": "string"
            },
            "title": "Sectors",
            "type": "array"
          },
          "seen_on": {
            "items": {
              "type": "string"
            },
            "title": "Seen On",
            "type": "array"
          },
          "source_url": {
            "default": "",
            "title": "Source Url",
            "type": "string"
          },
          "stages": {
            "description": "Eligible startup stages. Empty if not stated.",
            "items": {
              "enum": [
                "idea",
                "pre-seed",
                "seed",
                "series-a+"
              ],
              "type": "string"
            },
            "title": "Stages",
            "type": "array"
          },
          "summary": {
            "default": "",
            "description": "One or two English sentences on what the program offers.",
            "title": "Summary",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "default": "other",
            "enum": [
              "accelerator",
              "grant",
              "competition",
              "gov_scheme",
              "credits",
              "investment",
              "other"
            ],
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "title",
          "organiser"
        ],
        "title": "Program",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Startup ASEAN Gateway",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/deck": {
      "post": {
        "operationId": "deck_deck_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_deck_deck_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Deck"
      }
    },
    "/gapmap": {
      "get": {
        "operationId": "gap_gapmap_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Gap"
      }
    },
    "/ingest": {
      "post": {
        "operationId": "ingest_ingest_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IngestRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Ingest"
      }
    },
    "/match": {
      "post": {
        "operationId": "match_profile_match_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Profile"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Match"
                  },
                  "title": "Response Match Profile Match Post",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Match Profile"
      }
    },
    "/programs": {
      "get": {
        "operationId": "programs_programs_get",
        "parameters": [
          {
            "in": "query",
            "name": "open_only",
            "required": false,
            "schema": {
              "default": true,
              "title": "Open Only",
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Program"
                  },
                  "title": "Response Programs Programs Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Programs"
      }
    },
    "/programs/{pid}": {
      "get": {
        "operationId": "program_programs__pid__get",
        "parameters": [
          {
            "in": "path",
            "name": "pid",
            "required": true,
            "schema": {
              "title": "Pid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Program"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Program"
      }
    },
    "/stats": {
      "get": {
        "operationId": "stats_stats_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Stats"
      }
    }
  }
}
